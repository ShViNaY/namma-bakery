# ==============================================================================
# NAMMA BAKERY — PRODUCTION & LOCAL ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development.
# On Vercel, configure these variables in: Project Settings -> Environment Variables.
#
# IMPORTANT:
# - NEVER commit .env.local or any real production credentials to Git.
# - Variables starting with NEXT_PUBLIC_ are bundled into client-side JavaScript.
# - Variables without NEXT_PUBLIC_ are server-only and must NEVER reach the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / BROWSER-SAFE VARIABLES (Accessible on Client & Server)
# ------------------------------------------------------------------------------

# Supabase Project URL (e.g., https://your-project.supabase.co or http://127.0.0.1:54321 for local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Publishable API Key (safe for browser client-side queries protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Canonical Site URL (Optional, e.g. https://nammabakery.com)
# Used for SEO canonical URLs, sitemap.xml, robots.txt, and Open Graph cards.
# If omitted on Vercel, automatically falls back to VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://nammabakery.com

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER Exposed to the Browser Runtime)
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Bypasses Row Level Security)
# Required exclusively by server-side RPCs, order creation, admin management, and rate limiting.
# STRICTLY GUARDED: Enforced by `import "server-only"` in lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
